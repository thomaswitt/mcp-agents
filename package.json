{
  "name": "mcp-agents",
  "version": "0.31.0",
  "description": "MCP server that wraps AI CLI tools and proxies Chrome DevTools MCP to remote browser leases",
  "type": "module",
  "scripts": {
    "bench:mcp-startup": "node scripts/bench-mcp-startup.mjs"
  },
  "bin": {
    "mcp-agents": "server.js"
  },
  "files": [
    "server.js",
    "codex-legacy.js",
    "scripts/bench-mcp-startup.mjs",
    "package.json"
  ],
  "keywords": [
    "mcp",
    "claude",
    "gemini",
    "codex",
    "browser",
    "chrome",
    "anthropic",
    "google",
    "openai",
    "ai",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaswitt/mcp-agents.git"
  },
  "author": "Thomas Witt",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "chrome-devtools-mcp": "latest"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "hono": "^4.12.22",
    "ip-address": "^10.2.0"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT"
}
